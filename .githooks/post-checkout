#!/bin/sh
#
# post-checkout — set the commit identity per branch.
#
# Git has no native per-branch user.email, so we rewrite the repo-local
# identity on every branch switch. Runs only when $3 is 1 (branch switch);
# a file checkout ($3 = 0) is ignored.
#
# Add a branch below to give it its own identity. Anything not listed falls
# back to the global identity (~/.gitconfig).

[ "$3" = "1" ] || exit 0

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

case "$branch" in
  release)
    git config user.name  "tudou527"
    git config user.email "tudou527@gmail.com"
    ;;
  *)
    git config --unset user.name  2>/dev/null
    git config --unset user.email 2>/dev/null
    ;;
esac

exit 0
