# EventPort site (Next.js) environment variables.
# Copy to .env.local and fill in real values. Parsing logic: lib/env.ts.

# --- Required ---

# Event gateway base URL (the Cloudflare Worker, gw.eventport.dev in production,
# http://127.0.0.1:8787 for local `wrangler dev`).
NEXT_PUBLIC_GATEWAY_URL=https://gw.eventport.dev

# Public site URL (SEO metadata, sitemap/robots, agent guide links).
NEXT_PUBLIC_SITE_URL=https://eventport.dev

# Bearer token for the gateway's /internal/sql proxy (lib/db.ts).
# Must match the secret configured on the gateway Worker.
INTERNAL_SQL_SECRET=change-me

# Secret used to sign session cookies (middleware.ts / lib/session.ts).
SESSION_SECRET=change-me

# --- Optional: Google OAuth login (enabled only when both values are set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: bootstrap admin emails, comma-separated ---
ADMIN_EMAILS=

# --- Optional: transactional email ---
# Comma-separated list of enabled providers, e.g. "brevo,resend".
# Each provider is picked up only when <PREFIX>_API_KEY and <PREFIX>_FROM are set.
EMAIL_PROVIDERS=
BREVO_API_KEY=
BREVO_FROM=
RESEND_API_KEY=
RESEND_FROM=
